<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn on the car screen (see CarContent). Only one section is visible at a time. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/car_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/car_home_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/car_home_subtitle"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_videos"
                style="@style/CarTile">

                <ImageView
                    style="@style/CarTileIcon"
                    android:src="@drawable/ic_video" />

                <TextView
                    style="@style/CarTileLabel"
                    android:text="@string/tile_videos" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_youtube"
                style="@style/CarTile">

                <ImageView
                    style="@style/CarTileIcon"
                    android:src="@drawable/ic_youtube" />

                <TextView
                    style="@style/CarTileLabel"
                    android:text="@string/tile_youtube" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_links"
                style="@style/CarTile">

                <ImageView
                    style="@style/CarTileIcon"
                    android:src="@drawable/ic_link" />

                <TextView
                    style="@style/CarTileLabel"
                    android:text="@string/tile_links" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_mirror"
                style="@style/CarTile">

                <ImageView
                    style="@style/CarTileIcon"
                    android:src="@drawable/ic_mirror" />

                <TextView
                    style="@style/CarTileLabel"
                    android:text="@string/tile_mirror" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_dashboard"
                style="@style/CarTile">

                <ImageView
                    style="@style/CarTileIcon"
                    android:src="@drawable/ic_dashboard" />

                <TextView
                    style="@style/CarTileLabel"
                    android:text="@string/tile_dashboard" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:use_controller="true" />

    <TextView
        android:id="@+id/video_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:ellipsize="end"
        android:maxWidth="480dp"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/mirror_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone">

        <androidx.media3.ui.AspectRatioFrameLayout
            android:id="@+id/mirror_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:resize_mode="fit">

            <TextureView
                android:id="@+id/mirror_texture"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.media3.ui.AspectRatioFrameLayout>

        <TextView
            android:id="@+id/mirror_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/mirror_waiting"
            android:textColor="@android:color/white"
            android:textSize="18sp" />
    </FrameLayout>

    <!-- OBD-II car dashboard; the gauges are added by CarContent. -->
    <LinearLayout
        android:id="@+id/dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/car_home_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <!-- The end margin leaves room for the back / close buttons. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="136dp"
            android:maxLines="1"
            android:text="@string/dashboard_title"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dashboard_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="136dp"
            android:layout_marginBottom="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/gauge_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/gauge_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:id="@+id/dashboard_codes"
                style="@style/CarTextButton"
                android:text="@string/dashboard_fault_codes" />

            <TextView
                android:id="@+id/dashboard_adapter"
                style="@style/CarTextButton"
                android:text="@string/dashboard_change_adapter" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lists (phone videos, saved links) when there are no Android Auto list templates. -->
    <LinearLayout
        android:id="@+id/list_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2121418"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/list_back"
                style="@style/CarControl"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/list_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="22sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/list_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/list_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp" />
        </ScrollView>
    </LinearLayout>

    <!-- Back / close buttons, shown when running as the car activity. -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/car_message_bg"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/control_back"
            style="@style/CarControl"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/control_close"
            style="@style/CarControl"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/car_message_bg"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:visibility="gone" />
</FrameLayout>
