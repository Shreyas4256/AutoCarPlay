<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn on the Android Auto screen (see CarPresentation). Only one section is visible at a time. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/car_home_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/car_home_subtitle"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_videos"
                style="@style/CarTile">

                <ImageView
                    style="@style/CarTileIcon"
                    android:src="@drawable/ic_video" />

                <TextView
                    style="@style/CarTileLabel"
                    android:text="@string/tile_videos" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_youtube"
                style="@style/CarTile">

                <ImageView
                    style="@style/CarTileIcon"
                    android:src="@drawable/ic_youtube" />

                <TextView
                    style="@style/CarTileLabel"
                    android:text="@string/tile_youtube" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_links"
                style="@style/CarTile">

                <ImageView
                    style="@style/CarTileIcon"
                    android:src="@drawable/ic_link" />

                <TextView
                    style="@style/CarTileLabel"
                    android:text="@string/tile_links" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_mirror"
                style="@style/CarTile">

                <ImageView
                    style="@style/CarTileIcon"
                    android:src="@drawable/ic_mirror" />

                <TextView
                    style="@style/CarTileLabel"
                    android:text="@string/tile_mirror" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:use_controller="true" />

    <TextView
        android:id="@+id/video_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:ellipsize="end"
        android:maxWidth="480dp"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/mirror_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone">

        <androidx.media3.ui.AspectRatioFrameLayout
            android:id="@+id/mirror_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:resize_mode="fit">

            <TextureView
                android:id="@+id/mirror_texture"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.media3.ui.AspectRatioFrameLayout>

        <TextView
            android:id="@+id/mirror_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/mirror_waiting"
            android:textColor="@android:color/white"
            android:textSize="18sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/car_message_bg"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:visibility="gone" />
</FrameLayout>
